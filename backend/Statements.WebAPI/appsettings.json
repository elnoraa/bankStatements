{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "{LocalTimestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/statements-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{LocalTimestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "CurrencyApi": {
    "BaseUrl": "https://open.er-api.com",
    "CacheDurationMinutes": 60
  },
  "Email": {
    "UseFileOutput": true,
    "FromAddress": "noreply@bankstatements.app",
    "FromName": "Bank Statements",
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  "ClamAv": {
    "Host": "clamav",
    "Port": 3310,
    "ScanTimeoutSeconds": 30
  },
  "Basiq": {
    "ApiBaseUrl": "https://au-api.basiq.io",
    "ApiKey": "",
    "ConsentRedirectUrl": "",
    "TokenCacheMinutes": 50,
    "SyncCheckIntervalMinutes": 5
  }
}
